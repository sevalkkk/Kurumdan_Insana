# ============================================================================
# KURUMDAN İNSANA — FIREBASE FIRESTORE & AUTHENTICATION YAPILANDIRMASI
# ============================================================================
# Gerçek Firebase projenizi bağlamak için bu dosyayı `.env` adıyla kopyalayın
# ve Firebase Console -> Project Settings -> General altındaki değerleri girin.
# Bu alanlar boş bırakıldığında uygulama otomatik olarak yerel Firestore
# emülatör/fallback katmanı üzerinde aynı şema ile sorunsuz çalışır.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

